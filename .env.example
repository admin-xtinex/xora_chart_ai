# XORA Chart AI

PORT=8030
LOG_LEVEL=INFO

# Worker → API (docker-compose sets this automatically)
# XORA_API_BASE=http://localhost:8030

# AI validation (optional)
# Without a key, rule-based validation is used automatically.
# OPENAI_API_KEY=sk-...
# XORA_AI_API_KEY=          # alias for OPENAI_API_KEY
# XORA_AI_BASE_URL=https://api.openai.com/v1
# XORA_AI_MODEL=gpt-4o-mini
