# XORA Chart AI

PORT=8030
LOG_LEVEL=INFO

# Public Binance Futures historical REST endpoint.
# The browser uses VITE_BINANCE_FUTURES_REST_BASE so production can fetch public
# history from the user's network when the GCP egress IP receives Binance HTTP 451.
BINANCE_FUTURES_REST_BASE=https://fapi.binance.com
VITE_BINANCE_FUTURES_REST_BASE=https://fapi.binance.com/fapi/v1

# Trade Engine: demo (default) | live
XORA_TRADE_MODE=demo
