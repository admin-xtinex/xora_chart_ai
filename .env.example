# XORA Chart AI

PORT=8030
LOG_LEVEL=INFO

# Public Binance Futures historical REST endpoint.
# The browser uses VITE_BINANCE_FUTURES_REST_BASE so production can fetch public
# history from the user's network when the GCP egress IP receives Binance HTTP 451.
BINANCE_FUTURES_REST_BASE=https://fapi.binance.com
VITE_BINANCE_FUTURES_REST_BASE=https://fapi.binance.com/fapi/v1

# Trade Engine: demo (default) | live
XORA_TRADE_MODE=demo
XORA_MAX_OPEN_POSITIONS=20

# Optional read-only LLM explanations. Disabled until explicitly enabled.
# Provider order is also the automatic failover order.
XORA_LLM_ENABLED=false
XORA_LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=
GEMINI_API_KEY=
XORA_GROQ_MODEL=openai/gpt-oss-20b
XORA_GEMINI_MODEL=gemini-2.5-flash-lite
XORA_LLM_REQUESTS_PER_MINUTE=5
XORA_LLM_TIMEOUT_SECONDS=20
XORA_LLM_CACHE_TTL_SECONDS=900
XORA_LLM_PROVIDER_COOLDOWN_SECONDS=60

# First admin login, used only when no users exist yet (users are stored in
# users.json next to XORA_STATE_FILE). Remove the password once signed in.
XORA_ADMIN_USERNAME=
XORA_ADMIN_PASSWORD=

# Read-only feed for the XORA trading app (WebSocket actions xora.groups / xora.signals).
# At least 24 characters; unset = feed off. Set the same value in XORA's server.
XORA_SERVICE_KEY=
