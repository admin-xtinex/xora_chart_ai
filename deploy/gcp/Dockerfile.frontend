FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ .
ARG VITE_WS_BASE=
ENV VITE_WS_BASE=$VITE_WS_BASE
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/gcp/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=20s --timeout=5s --retries=3 CMD wget --spider --no-check-certificate --server-response http://127.0.0.1/ 2>&1 | grep -Eq 'HTTP/[0-9.]+ (200|301|302)' || exit 1
CMD ["nginx", "-g", "daemon off;"]
